# Public backend URL (no trailing slash).
# Local: leave unset or use http://localhost:5000
# Production (Netlify): set VITE_API_URL in Site settings → Environment variables,
# then trigger a new deploy. Vite bakes VITE_* values in at build time.
VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
